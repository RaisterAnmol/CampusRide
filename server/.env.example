# ==============================================================================
# CampusRide — Backend Environment Configuration (.env)
# ==============================================================================
# Copy this file to `server/.env` to configure your local development or production environment.
# Never commit the actual `server/.env` file to Git!

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas SRV / Local / In-Memory)
# ------------------------------------------------------------------------------
# In development & testing, leaving this empty or omitted will automatically
# boot an in-memory MongoDB instance (mongodb-memory-server) with zero setup required.
# For persistent MongoDB Atlas via SRV, paste your connection string below:
# Format:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Example: mongodb+srv://campusadmin:MyStrongPass123@cluster0.abcde.mongodb.net/campusride?retryWrites=true&w=majority
MONGODB_URI=

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# [BLANK SPACE FOR YOUR CUSTOM JWT SECRET]
# In development, leave blank to use the secure built-in fallback:
# Special Value: CampusRide_Special_Jwt_Secret_2025_Key_ProdSecure_99x82!
# In production, set a 64-char random hex secret:
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
ADMIN_SECRET=CampusRide_Special_Admin_Secret_2025_Root!

# ------------------------------------------------------------------------------
# 4. DEMO / SEED CREDENTIALS
# ------------------------------------------------------------------------------
# Password used for all 14 pre-seeded demo accounts (Aditya, Rahul, Priya, etc.)
DEMO_USER_PASSWORD=CampusRide2025!

# ------------------------------------------------------------------------------
# 5. MAPS & LOCATION (FREE OPENSTREETMAP / GOOGLE MAPS)
# ------------------------------------------------------------------------------
# Modes:
#   - 'free': 100% Free Live Geocoding & Road Routing via OpenStreetMap & OSRM
#             (Real street data worldwide, NO credit card, NO billing required)
#   - 'live': Google Maps Platform (Requires GOOGLE_MAPS_API_KEY below)
#   - 'mock': Fast offline deterministic campus fixtures for instant tests
MAPS_MODE=free
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 6. SMS & OTP DISPATCH (TWILIO) (OPTIONAL / HYBRID MOCK)
# ------------------------------------------------------------------------------
# If SMS_MODE=mock or credentials omitted, OTPs and phone verifications will be logged to console
# and returned via the dev response payload (devOtpHint) without consuming SMS credits.
SMS_MODE=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------------------------
# 7. PUSH NOTIFICATIONS (FIREBASE) (OPTIONAL / HYBRID MOCK)
# ------------------------------------------------------------------------------
PUSH_MODE=mock
FIREBASE_PROJECT_ID=
