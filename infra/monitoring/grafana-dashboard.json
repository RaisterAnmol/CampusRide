{
  "title": "CampusRide Production Health & Telemetry",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(campusride_http_requests_total[1m])) by (method, status_code)",
          "legendFormat": "{{method}} {{status_code}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Request Duration (p95 & p99 Latency)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(campusride_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(campusride_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Active WebSocket Connections",
      "type": "stat",
      "targets": [
        {
          "expr": "campusride_active_socket_connections",
          "legendFormat": "Active Sockets"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "title": "Matching Engine Duration (p95)",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(campusride_matching_engine_computation_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Match Compute"
        }
      ],
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 }
    }
  ],
  "schemaVersion": 36,
  "version": 1
}
